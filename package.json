{
  "name": "sven-studio-3d",
  "version": "1.5.23",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"node server/index.js\" \"vite --host 127.0.0.1 --strictPort --open\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "modeling-check": "node scripts/check-modeling.mjs",
    "shapes-check": "node scripts/check-shapes.mjs",
    "labels-check": "node scripts/check-entity-labels.mjs",
    "verify:labels-preview5": "node --test tests/map-entity-labels-preview4.test.mjs tests/map-entity-labels-preview5.test.mjs",
    "verify:labels-preview4": "node --test tests/map-entity-labels-preview4.test.mjs",
    "server": "node server/index.js",
    "entity-check": "node scripts/check-entity-studio.mjs",
    "v05-check": "node scripts/check-v05.mjs",
    "models-fix-check": "node scripts/check-model-fixes.mjs",
    "v0521-check": "node scripts/check-v0521.mjs",
    "gameplay-check": "node scripts/check-gameplay.mjs",
    "npc-check": "node scripts/check-npc.mjs",
    "sound-check": "node scripts/check-sound.mjs",
    "organization-check": "node scripts/check-organization.mjs",
    "audio-converter-check": "node scripts/check-audio-converter.mjs",
    "lighting-check": "node scripts/check-lighting.mjs",
    "skies-check": "node scripts/check-skies.mjs",
    "lighting-scene-check": "node scripts/check-lighting-scene.mjs",
    "sky-build-check": "node scripts/check-sky-build.mjs",
    "advanced-check": "node scripts/check-advanced-070.mjs && node scripts/check-advanced-state-070.mjs",
    "uv-i18n-check": "node scripts/check-uv-i18n-0702.mjs",
    "professional-check": "node scripts/check-professional-080.mjs",
    "large-maps-check": "node scripts/check-large-maps-081.mjs",
    "session-check": "node scripts/check-session-082.mjs",
    "ui083-check": "node scripts/check-ui-083.mjs",
    "architecture-check": "node scripts/check-architecture-086.mjs",
    "bsp-viewer-check": "node scripts/check-bsp-088.mjs",
    "interactive-architecture-check": "node scripts/check-interactive-087.mjs && node scripts/check-interactive-state-087.mjs",
    "verify:stable": "node scripts/check-stable.mjs",
    "verify:cinematic": "node scripts/check-cinematic.mjs",
    "verify:cinematic-preview3": "node scripts/check-cinematic-preview3.mjs",
    "verify:gameplay-preview4": "node scripts/check-gameplay-preview4.mjs",
    "verify:custom-npc": "node scripts/check-custom-npc.mjs && node scripts/check-custom-npc-state.mjs",
    "verify:packager": "node --test tests/map-packager.test.mjs",
    "verify:terrain": "node scripts/check-terrain.cjs",
    "verify:viewport-preview4": "node scripts/check-viewport-preview4.cjs",
    "verify:layout-preview6": "node scripts/check-layout-preview6.cjs",
    "verify:gameplay-test": "node scripts/check-gameplay-test.cjs",
    "verify:bsp-recovery": "node --test tests/bsp-native-edit.test.mjs && node --test tests/bsp-to-map.test.mjs && node --test tests/bsp-surface-restore.test.mjs",
    "verify:texture-studio": "node --experimental-strip-types --test tests/texture-studio-v14.test.mjs tests/texture-ui-integration-v14.test.mjs",
    "verify:construction-v14": "node --experimental-strip-types --test tests/construction-workflow-v14.test.mjs",
    "verify:shape-prefab-hf2": "node --test tests/shape-prefab-viewport-hf2.test.mjs",
    "verify:hf14": "node scripts/verify-hf14.mjs",
    "verify:hf15": "node scripts/verify-hf15.mjs",
    "verify:hf15-hf4": "node scripts/verify-hf15-p2-hf4.mjs",
    "verify:hf15-hf5": "node scripts/verify-hf15-p2-hf5.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "three-stdlib": "^2.35.16",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
