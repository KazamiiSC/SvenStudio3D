  "dependencies": {
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "three-stdlib": "^2.35.16",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "main": "electron/main.cjs",
  "description": "SvenStudio 3D — GoldSrc map editor for Sven Co-op and Counter-Strike 1.6",
  "author": "SvenStudio 3D",
  "build": {
    "appId": "com.svenstudio3d.editor",
    "productName": "SvenStudio 3D",
    "copyright": "SvenStudio 3D",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "public/**",
      "tools/**",
      "SvenStudio3D.ico",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "SvenStudio3D.ico",
      "executableName": "SvenStudio3D",
      "artifactName": "SvenStudio3D-Desktop-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SvenStudio 3D",
      "artifactName": "SvenStudio3D-Setup-${version}.${ext}"
    }
  }
}
